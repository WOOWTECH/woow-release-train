        <record id="cloud_app_n8n" model="woow_paas_platform.cloud_app_template">
            <field name="name">n8n</field>
            <field name="slug">n8n</field>
            <field name="description">工作流程自動化工具</field>
            <field name="category">automation</field>
            <field name="tags">["n8n", "automation", "workflow", "integration", "no-code"]</field>
            <field name="documentation_url">https://docs.n8n.io/</field>
            <field name="helm_repo_url"></field>
            <field name="helm_chart_name">oci://8gears.container-registry.com/library/n8n</field>
            <field name="helm_chart_version">2.0.1</field>
            <field name="helm_default_values">{
                "image": {"repository": "jcr-prod.woowtech.io/woow-paas-docker-local/n8n",
                "tag": "20261013.2012@sha256:e0e7b603b43adc48d7123716b9eee7394dca675b410f574e4d24830e114564ce"},
                "main":
                {"config": {"GENERIC_TIMEZONE": "Asia/Taipei", "N8N_LOG_LEVEL": "info",
                "N8N_PUBLIC_API_ENABLED": "true"},
                "resources": {"requests": {"cpu": "100m", "memory": "256Mi"}, "limits": {"cpu":
                "1000m", "memory": "1Gi"}},
                "persistence": {"enabled": true, "type": "dynamic", "size": "2Gi"},
                "livenessProbe": {"httpGet": {"path": "/healthz", "port": "http"},
                "initialDelaySeconds": 180, "periodSeconds": 20, "timeoutSeconds": 5, "failureThreshold": 6},
                "readinessProbe": {"httpGet": {"path": "/healthz/readiness", "port": "http"},
                "periodSeconds": 10, "timeoutSeconds": 3, "failureThreshold": 3},
                "secret": {"N8N_API_KEY": "set-by-platform-init"}},
                "updateStrategy": {"type": "Recreate"}}</field>
            <field name="default_port">5678</field>
            <field name="ingress_enabled" eval="True" />
            <field name="min_vcpu">1</field>
            <field name="min_ram_gb">2.0</field>
            <field name="min_storage_gb">5</field>
            <field name="is_active" eval="True" />
            <field name="mcp_enabled" eval="False" />
            <field name="mcp_sidecar_image" eval="False" />
            <field name="mcp_sidecar_env" eval="False" />
            <field name="mcp_api_key_helm_path" eval="False" />
            <field name="post_deploy_init_type">n8n</field>
            <field name="post_deploy_init_email">admin@woowtech.io</field>
            <field name="app_admin_reset_kind">n8n_exec</field>
        </record>
        <record id="cloud_app_emqx" model="woow_paas_platform.cloud_app_template">
            <field name="name">EMQX</field>
            <field name="slug">emqx</field>
            <field name="description">開源 MQTT 訊息中介（broker）：物聯網裝置的連線與訊息轉送，附網頁管理後台。WebSocket 裝置直接連服務網址，原生 MQTT 對外透過你自己的 ngrok 帳號。1 vCPU／2 GB RAM／3 GB 磁碟</field>
            <field name="category">automation</field>
            <field name="tags">["emqx", "mqtt", "iot", "broker", "messaging"]</field>
            <field name="documentation_url">https://github.com/WOOWTECH/Woow_k3s_emqx#readme</field>
