        <record id="cloud_app_litellm" model="woow_paas_platform.cloud_app_template">
            <field name="name">AI 模型閘道（LiteLLM）</field>
            <field name="slug">litellm</field>
            <field name="description">OpenAI 相容的 AI 模型閘道：一個 API 端點接上 OpenAI、Anthropic、Google、OpenRouter 等多家模型，用虛擬金鑰分給各應用程式並控管預算與用量，附網頁管理後台與專屬資料庫。1 vCPU／4 GB RAM／5 GB 磁碟</field>
            <field name="category">ai_llm</field>
            <field name="tags">["litellm", "llm", "ai-gateway", "openai", "proxy"]</field>
            <field name="documentation_url">https://docs.litellm.ai/docs/</field>
            <field name="helm_repo_url"></field>
            <field name="helm_chart_name">oci://jcr-prod.woowtech.io/woow-paas-docker-local/litellm</field>
            <field name="helm_chart_version">0.3.5</field>
            <field name="helm_default_values">{"image":{"repository":"jcr-prod.woowtech.io/woow-paas-docker-local/litellm","tag":"20261015.0956@sha256:35a2eca3fbc0edcd4da8de2bcf3d05248198b790da6d7dca9e1b3584185f38b0"},"postgresql":{"image":{"repository":"jcr-prod.woowtech.io/woow-paas-docker-local/paas-postgres","tag":"17.11-20260928.1549@sha256:dbd1fed8882043f45bf759e8f7c73092505ef0afef7a23a93b177e6f7c2c840f"},"resources":{"limits":{"cpu":"1"}}},"gateway":{"externalPath":"/v1"},"auth":{"adminUser":"admin"},"persistence":{"size":"5Gi"},"service":{"port":4000}}</field>
            <field name="default_port">4000</field>
            <field name="ingress_enabled" eval="True"/>
            <field name="min_vcpu">1</field>
            <field name="min_ram_gb">4.0</field>
            <field name="min_storage_gb">5</field>
            <field name="mcp_enabled" eval="False"/>
            <field name="has_admin_gui" eval="True"/>
            <field name="admin_password_carrier">helm_secret</field>
            <field name="admin_password_settable" eval="True"/>
            <field name="admin_username_helm_path">auth.adminUser</field>
